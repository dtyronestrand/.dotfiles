# Homebrew Bundle file for macOS setup

# Taps
tap "homebrew/bundle"
tap "homebrew/cask"
tap "homebrew/core"

# Binaries
brew "git"
brew "wget"
brew "curl"
brew "vim"
brew "zsh"
brew "tree"
brew "htop"

# Applications
cask "visual-studio-code"
cask "iterm2"
cask "google-chrome"
cask "slack"
cask "docker"

# Mac App Store applications (requires mas)
brew "mas"
